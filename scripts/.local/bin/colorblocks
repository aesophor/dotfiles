#!/bin/bash
# Show the terminal colour scheme as blocks (macOS-compatible)

d=$'\e[1m'  # bold
t=$'\e[0m'  # reset

# Generate foreground color codes (f0 to f7)
for i in {0..7}; do
  eval "f$i=\$(printf '\e[3%sm' $i)"
done

# Print colored blocks
echo -e "${f1}██████${d}██${t} ${f2}██████${d}██${t} ${f3}██████${d}██${t} ${f4}██████${d}██${t} ${f5}██████${d}██${t} ${f6}██████${d}██${t}"
echo -e "${f1}██████${d}██${t} ${f2}██████${d}██${t} ${f3}██████${d}██${t} ${f4}██████${d}██${t} ${f5}██████${d}██${t} ${f6}██████${d}██${t}"
echo -e "${f1}██████${d}██${t} ${f2}██████${d}██${t} ${f3}██████${d}██${t} ${f4}██████${d}██${t} ${f5}██████${d}██${t} ${f6}██████${d}██${t}"
echo -e "${f0}██████${d}${f7}██${t} ${f0}██████${d}${f7}██${t} ${f0}██████${d}${f7}██${t} ${f0}██████${d}${f7}██${t} ${f0}██████${d}${f7}██${t} ${f0}██████${d}${f7}██${t}"
